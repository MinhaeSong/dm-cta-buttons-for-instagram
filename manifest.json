{
  "manifest_version": 3,
  "name": "IG DM 버튼 표시기",
  "version": "1.0.0",
  "description": "인스타그램 PC 웹 DM에서 보이지 않는 자동 DM 버튼(postback, 링크)을 표시하고 누를 수 있게 합니다.",
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
